# Copia a deploy/.env (install.sh lo hace por ti y genera las claves).

# ":80" = solo HTTP por IP. Un dominio (api.midominio.com) activa HTTPS automático.
SITE_ADDRESS=:80
APP_URL=http://localhost

# php artisan key:generate --show
APP_KEY=

DB_DATABASE=domiquibdo
DB_USERNAME=domiquibdo
DB_PASSWORD=

PHP_WORKERS=4

# PayU: sin estas líneas se usan las credenciales públicas de sandbox (no cobran).
# PAYU_MERCHANT_ID=
# PAYU_ACCOUNT_ID=
# PAYU_API_KEY=
# PAYU_TEST=false
# PAYU_CHECKOUT_URL=https://checkout.payulatam.com/ppp-web-gateway-payu/
