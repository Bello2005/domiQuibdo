# Copia a deploy/.env (install.sh lo hace por ti y genera las claves).

# ":80" = solo HTTP por IP. Un dominio (api.midominio.com) activa HTTPS automático.
SITE_ADDRESS=:80
APP_URL=http://localhost

# php artisan key:generate --show
APP_KEY=

DB_DATABASE=domiquibdo
DB_USERNAME=domiquibdo
DB_PASSWORD=

# true habilita /api/demo/* (avanzar pedidos desde la cuenta del cliente). Para la presentación; false en uso real.
APP_DEMO=true
PHP_WORKERS=4
